# ---- 依赖 / 构建产物 ----
node_modules/
dist/
build/
out/
target/
*.egg-info/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 环境与密钥 ----
.env
.env.*
!.env.example
*.local
*.key
*.pem

# ---- 编辑器 / IDE ----
.idea/
.vscode/
!.vscode/settings.json
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 / 临时文件 ----
*.log
logs/
tmp/
temp/
*.tmp

# ---- 本机工作区私有数据（保留 .workbuddy 目录本身，忽略其运行产物）----
.workbuddy/memory/
.workbuddy/cache/
# 验证探针与截图属于临时产物，不入库（不复用、不需评审）
.workbuddy/probe/
.workbuddy/shots/
.workbuddy/backups/
.workbuddy/tools/
.workbuddy/video-tools/
# 演示工作区与验收脚本：一次性产物
.workbuddy/demo/
# 一次性端到端验证脚本与其工作区（pf_check*.py 之类）。
# 它们验证完就没用了，留着只会污染 git status —— 关键是会掩盖真实改动。
.workbuddy/*.py
.workbuddy/pf-e2e*/
.workbuddy/goal-e2e/

# ---- harness 运行时产物 ----
# 会话落盘（trajectory / events / meta）与工具产出的 artifacts，
# 都是"跑一次就有一份"的运行数据，属本机工作区私有。
# 但 .crucibleignore 之类的**配置**要入库，所以用 `**` 精确匹配运行目录。
**/.crucible/runs/
**/.crucible/artifacts/
# 模型接入配置：**含明文 API Key**，绝不能入库
**/.crucible/config.json
**/.crucible/config.json.tmp
.workbuddy/commit-msg.txt
.workbuddy/commit-msg*.txt
